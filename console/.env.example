# itools-console 的环境变量模板。复制成 .env 再填真实值（.env 已 gitignore）。
#
# ⚠ 凭据（数据库口令、引导口令）**只从环境变量读**，源码与镜像里零明文。
#    这个仓库是公开的，运维拓扑（主机名 / 端口 / 地址）同样不进源码。

# ---- 监听 ----
# 生产走 host 网络时绑 127.0.0.1，对外由 frp / 反向代理透传；
# 容器内网络时才用 0.0.0.0。
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=7005

# ---- 数据库（与云同步服务端同一个库）----
CONSOLE_DB_HOST=127.0.0.1
CONSOLE_DB_PORT=3306
CONSOLE_DB_USER=root
CONSOLE_DB_PASSWORD=
CONSOLE_DB_NAME=itools
# 连接池上限。控制台并发很低，5 足够，别跟主服务抢连接。
CONSOLE_DB_CONNLIMIT=5
# 可选：一把梭的完整连接串，设了会覆盖上面各分项
# CONSOLE_DB_URL=mysql://user:pass@host:3306/itools

# ---- TLS ----
# 两个必须同时配，只配一个会启动失败（防止后台静默降级成明文 HTTP）。
# 生产是 frp 纯 TCP 透传，证书由本进程终结，与云同步服务端共用同一份。
CONSOLE_TLS_CERT_FILE=/certs/fullchain.pem
CONSOLE_TLS_KEY_FILE=/certs/key.pem

# ---- 前端 ----
# 镜像里已内置一份（/app/web）。挂载卷覆盖后，改前端 scp 即生效、无需重发镜像。
CONSOLE_WEB_DIR=/app/web

# ---- 会话与限流 ----
# 控制台会话有效期（秒）。默认 8 小时；不做「永不过期」。
CONSOLE_SESSION_TTL_SEC=28800
# 登录限流：每 IP 每窗口最多几次。0 = 关闭（不建议——控制台是运营入口）。
CONSOLE_LOGIN_RATE_MAX=10
CONSOLE_LOGIN_RATE_WINDOW_SEC=300
# 置于反向代理 / frp HTTP 模式之后时必须为 true，否则限流按代理 IP 计数形同虚设。
# ⚠ frp 的 TCP 透传模式下服务端看到的对端恒为回环地址，此项设 true 也没有 XFF 可用——
#   那种部署下登录限流实际是全局闸门，请把 CONSOLE_LOGIN_RATE_MAX 设得宽松些。
CONSOLE_TRUST_PROXY=false

# ---- 首次引导 ----
# 只在 console_admins 表为空时生效，建出的账号是超级管理员且强制首次登录改口令。
# 表里已有账号后这两个变量会被忽略（不会覆盖已有口令，避免留后门）。
# 建好账号并改密后，建议从运行环境里移除这两行。
CONSOLE_BOOTSTRAP_USER=
CONSOLE_BOOTSTRAP_PASSWORD=

# ---- 云同步服务端健康探测 ----
# 留空则系统页如实显示「未配置探测地址」，不会谎报主服务故障。
CONSOLE_UPSTREAM_HEALTH_URL=
# 主服务用自签证书时才置 true（默认校验证书）。
CONSOLE_UPSTREAM_INSECURE=false

# ---- 其它 ----
# 统计按天/小时分桶的时区偏移（分钟）。480 = 东八区。
CONSOLE_TZ_OFFSET_MIN=480
# 访问日志开关。关掉只留 warn 以上。
CONSOLE_LOG=true
# 可选，更细的日志级别（语法同 RUST_LOG）
# CONSOLE_RUST_LOG=info,tower_http=debug
