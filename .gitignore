# 依赖与产物
node_modules/
dist/
/src-tauri/target/
/server/target/
/src-tauri/gen/schemas/

# 本地开发插件目录（插件源码在独立仓库 iTools-plugins，勿把部署副本混入宿主仓库）
/plugins/

# 开发者中心的固定调试目录（dev 构建下由 DevRuntime 自动创建在项目根，见 src-tauri/src/dev/mod.rs）
# 里面是半成品调试插件，比 /plugins/ 更不该进仓库——不忽略的话跑一次 tauri dev 就会被 git add 误提交
/dev-plugins/

# 编辑器/系统
.DS_Store
Thumbs.db
*.log

# 工具临时产物
.playwright-mcp/
.claude/

# 记忆库（含内部笔记/凭据，勿提交）
.engram/
