# scripts/publish.sh 的配置模板。
#
# 复制成仓库根的 .publish.env 再填真实值：
#     cp .publish.env.example .publish.env
#
# ⚠ .publish.env 已在 .gitignore 里，**不要**把填好的那份提交进来——
#    这个仓库是公开的，运维拓扑（主机名 / 端口 / 服务端地址）不进源码。
#    这条与 .github/workflows/release.yml 里「开源版不带服务端地址」是同一条原则。

# 自建服务器（群晖 NAS）的 SSH 目标与端口。需已配好免密公钥。
NAS_HOST=user@your-nas-host
NAS_PORT=22

# 自建服务版安装包要注入的服务端地址（编译期经 option_env! 进二进制）。
# 留空或不填 → publish.sh app 会直接报错退出，不会做出一个「连不上服务器」的包。
ITOOLS_DEFAULT_ENDPOINT=https://your-server:port

# NAS 上的托管目录（对应容器里的 SYNC_SITE_DIR / SYNC_DOWNLOADS_DIR）。
# 用默认值即可，除非改过 itools-sync-server 的挂载。
NAS_SITE_DIR=/volume1/docker/itools-data/site
NAS_DOWNLOADS_DIR=/volume1/docker/itools-data/downloads

# 公开访问地址，用于发布后**实测核产物**（首页 200、/api/download/latest 跟到新版本）。
# 留空则跳过这几步核验——不建议留空，那样就只能靠 scp 的退出码猜成没成。
SITE_URL=https://your-server:port
