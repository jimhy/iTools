{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin",
  "description": "插件页面窗口的受控 IPC：label=plugin（用户唤起的共享窗口）与 label=plugin-bg-<插件id>（开机自启动的后台常驻实例），均走 itplugin 自定义协议远程源。后台实例若不在此放行，它调任何 plugin_* 都会被 ACL 拒——表现为「自启动开了但插件什么都做不了」。Tauri v2 中 App 自有命令经 build.rs 的 AppManifest 纳入 ACL 后，本 capability 只授予下列 plugin_* 白名单命令——插件页无法调用 execute / save_settings 等主程序命令。",
  "windows": ["plugin", "plugin-bg-*", "plugin-win-*"],
  "remote": {
    "urls": ["http://itplugin.localhost", "http://itplugin.localhost/*"]
  },
  "permissions": [
    "core:event:default",
    "allow-plugin-take-enter",
    "allow-plugin-hide",
    "allow-plugin-exit",
    "allow-plugin-set-height",
    "allow-plugin-copy-text",
    "allow-plugin-read-text",
    "allow-plugin-read-image",
    "allow-plugin-write-image",
    "allow-plugin-save-image",
    "allow-plugin-read-file",
    "allow-plugin-write-file",
    "allow-plugin-remove-file",
    "allow-plugin-read-local-image",
    "allow-plugin-open-external",
    "allow-plugin-open-path",
    "allow-plugin-notify",
    "allow-plugin-run-command",
    "allow-plugin-fetch",
    "allow-plugin-camera-list",
    "allow-plugin-camera-grab",
    "allow-plugin-camera-stream-start",
    "allow-plugin-camera-stream-stop",
    "allow-plugin-audio-loopback-start",
    "allow-plugin-audio-loopback-stop",
    "allow-plugin-record-video-start",
    "allow-plugin-record-video-stop",
    "allow-plugin-register-main-push",
    "allow-plugin-main-push-result",
    "allow-search-push",
    "allow-plugin-notify-show",
