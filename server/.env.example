# iTools 云同步服务端配置（复制为 .env 或直接在环境里 export）
# 监听地址与端口
SYNC_HOST=127.0.0.1
SYNC_PORT=8787
# MariaDB 连接（服务端强制依赖 MariaDB；凭据只从环境变量读，源码零明文）
SYNC_DB_HOST=127.0.0.1
SYNC_DB_PORT=3306
SYNC_DB_USER=root
SYNC_DB_PASSWORD=
SYNC_DB_NAME=itools
SYNC_DB_CONNLIMIT=10
# 也可用单一连接串覆盖上面各项（可选）：
#   SYNC_DB_URL=mysql://user:pass@127.0.0.1:3306/itools
# 是否允许「首次登录即自动注册」（自托管场景默认开启，方便直接用）
SYNC_ALLOW_REGISTER=true
# 会话令牌随机字节数
SYNC_TOKEN_BYTES=32
# 是否打印访问日志（false 时只留 warn 及以上，启动提示与致命错误照常打印）
SYNC_LOG=true
# 更细的日志级别控制（可选，语法同 RUST_LOG，例：itools_sync=debug,tower_http=debug）
#   SYNC_RUST_LOG=info
# 是否信任反向代理的 X-Forwarded-For（决定 req.ip，进而决定限流按谁计数）。
# 置于 Nginx/Caddy 之后**必须**打开，否则所有客户端共用一个限流桶而互相误伤；
# 直接对外监听时保持 false（该头可被任意伪造）。可填 true / 跳数 / 受信任的 IP、CIDR 列表。
SYNC_TRUST_PROXY=false

# ---- GitHub 镜像源与健康探测（公开端点 GET /api/mirrors，供客户端选下载源）----
# 可编辑的镜像列表文件；缺失/写坏则用代码里的内置兜底列表。改完存盘即生效，无需重启。
# 不设置时取「工作目录下的 config/mirrors.json」（容器里即 /app/config/mirrors.json）。
#   SYNC_MIRRORS_FILE=/app/config/mirrors.json
# 定时探测开关与周期（秒，默认 900 = 15 分钟；下限 60）
SYNC_MIRROR_PROBE=true
SYNC_MIRROR_PROBE_INTERVAL_SEC=900
# 单次探测超时（毫秒）
SYNC_MIRROR_PROBE_TIMEOUT_MS=10000
# 连续失败多少次才判 unhealthy（恢复立即标回），避免网络抖动误杀
SYNC_MIRROR_FAIL_THRESHOLD=3
# /api/mirrors 响应的 Cache-Control max-age（秒）
SYNC_MIRROR_CACHE_SEC=300
# lastOkAt 时间戳的量化粒度（秒，默认 3600）。0 = 精确到毫秒，
# 但那样每轮探测都会改写响应体，客户端的 If-None-Match 基本不再命中 304（明确取舍，见 README）。
SYNC_MIRROR_OKAT_GRANULARITY_SEC=3600
# /api/mirrors 是全服唯一的免认证读端点，按 IP 限流：每窗口最大请求数 / 窗口长度（秒）。
# 默认 120 次 / 60 秒，对「本地 TTL 30 分钟」的正常客户端有三个数量级余量。0 = 关闭限流。
SYNC_MIRROR_RATE_MAX=120
SYNC_MIRROR_RATE_WINDOW_SEC=60
# 注意：探测经镜像访问，**服务器不需要能直连 GitHub、不需要 VPN**（详见 README）。

# ---- 插件市场与提审（GET /api/market/*、POST /api/plugins/submit）----
# 审核用的大模型（OpenAI 兼容协议）。
# ⚠ API key 只从环境变量读，**绝不要写进任何进仓库的文件**。这份 .env.example 里永远留空。
ITOOLS_LLM_BASE_URL=https://punkcodeai.myverse.site
ITOOLS_LLM_API_KEY=
ITOOLS_LLM_MODEL=gpt-5.5
# 单次审核超时（秒）。审代码的 prompt 很长，默认 300。
ITOOLS_LLM_TIMEOUT_SEC=300
# 输出上限（含推理 token）。给小了裁决会被截成半截 JSON → 判为「审核未完成」而非「通过」。
ITOOLS_LLM_MAX_TOKENS=16000
#
# ⚠ 没配 ITOOLS_LLM_API_KEY 时，提审只做机械校验，代码审核**不会执行**，
#   提交上来的插件会停在「待人工处理」而不会自动上线（绝不把没审当成审过了）。
#
# 已上线插件包的存放目录。容器里**必须挂持久卷**，否则重启后市场里的插件全部下载失败。
SYNC_PACKAGES_DIR=/app/data/packages
# 允许提审的最大包体积（MB），与客户端安装侧上限对齐
SYNC_MAX_UPLOAD_MB=32
# 维护者账号（逗号分隔的用户名）。只有他们能下架插件。空 = 没有任何人能做管理操作。
SYNC_ADMIN_USERS=
# 同一账号两次提审之间的最小间隔（秒）。审核要花模型的钱，必须挡住连点。
SYNC_SUBMIT_COOLDOWN_SEC=60
# /api/market/* 是免认证读端点，按 IP 限流（同 mirrors 的口径）。0 = 关闭。
SYNC_MARKET_RATE_MAX=120
SYNC_MARKET_RATE_WINDOW_SEC=60

# TLS（可选）：两个都设置后，本进程直接起 HTTPS、自行终结 TLS，
# 适配「frps/nps 纯 TCP 透传到本机、由本进程加载证书」的部署（中转节点看不到明文）。
# 只提供证书/私钥的「文件路径」，源码与配置里零明文私钥。不设则纯 HTTP（置于反向代理之后时用）。
#   SYNC_TLS_CERT_FILE=/certs/jimhy.cn/fullchain.pem
#   SYNC_TLS_KEY_FILE=/certs/jimhy.cn/key.pem

# 客户端侧：让 iTools 指向本服务端后，登录/云同步即真实生效
#   ITOOLS_SYNC_ENDPOINT=http://127.0.0.1:8787
